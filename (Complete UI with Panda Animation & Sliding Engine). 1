<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>PanDA HUD Overlay</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Segoe UI', Roboto, sans-serif;
      user-select: none;
    }

    body {
      background: transparent;
      overflow: hidden;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      height: 100vh;
      padding-top: 15px;
    }

    /* Floating Top HUD Bar */
    .hud-container {
      width: 840px;
      height: 125px;
      background: rgba(12, 18, 32, 0.88);
      border: 1.5px solid rgba(0, 255, 204, 0.4);
      backdrop-filter: blur(20px);
      border-radius: 65px;
      box-shadow: 0 10px 40px rgba(0, 255, 204, 0.2);
      display: flex;
      align-items: center;
      position: relative;
      padding: 10px 30px;
      transition: transform 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275), opacity 0.5s ease;
    }

    /* Cute SVG Panda Base & Motion */
    .panda-character {
      width: 85px;
      height: 85px;
      position: absolute;
      transition: all 0.8s cubic-bezier(0.68, -0.55, 0.265, 1.55);
      z-index: 10;
      filter: drop-shadow(0 5px 12px rgba(0,0,0,0.6));
    }

    .pos-left {
      left: 30px;
      transform: scaleX(1);
    }

    .pos-right {
      left: 725px;
      transform: scaleX(-1);
    }

    /* Info Content Box */
    .info-display {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      transition: all 0.5s ease;
    }

    .shift-right {
      padding-left: 110px;
      text-align: left;
    }

    .shift-left {
      padding-right: 110px;
      text-align: right;
    }

    .hud-title {
      font-size: 12px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #00ffcc;
      font-weight: 700;
      margin-bottom: 2px;
    }

    .hud-stat {
      font-size: 24px;
      font-weight: 800;
      letter-spacing: 0.5px;
      color: #ffffff;
      text-shadow: 0 0 10px rgba(0, 255, 204, 0.4);
    }

    .hud-desc {
      font-size: 12px;
      color: #8fa0be;
    }

    /* Panda Speech Bubble */
    .speech-bubble {
      position: absolute;
      top: -30px;
      background: #00ffcc;
      color: #0b1118;
      font-size: 11px;
      font-weight: 800;
      padding: 3px 10px;
      border-radius: 12px;
      box-shadow: 0 4px 10px rgba(0, 255, 204, 0.3);
      white-space: nowrap;
      transform: scaleX(1);
    }

    .pos-right .speech-bubble {
      transform: scaleX(-1);
    }

    /* Wiggling Ears */
    @keyframes earWiggle {
      0%, 100% { transform: rotate(0deg); }
      50% { transform: rotate(10deg); }
    }

    .ear-left { animation: earWiggle 2s infinite ease-in-out; transform-origin: bottom right; }
    .ear-right { animation: earWiggle 2s infinite ease-in-out reverse; transform-origin: bottom left; }
  </style>
</head>
<body>

  <div class="hud-container" id="hudContainer">
    
    <!-- Panda Vector -->
    <div class="panda-character pos-left" id="pandaActor">
      <div class="speech-bubble" id="speechText">Waking up PanDA...</div>
      <svg viewBox="0 0 100 100" width="100%" height="100%">
        <circle class="ear-left" cx="23" cy="23" r="14" fill="#1e222b"/>
        <circle class="ear-right" cx="77" cy="23" r="14" fill="#1e222b"/>
        <circle cx="23" cy="23" r="7" fill="#ff7597"/>
        <circle cx="77" cy="23" r="7" fill="#ff7597"/>
        <ellipse cx="50" cy="52" rx="40" ry="36" fill="#ffffff"/>
        <ellipse cx="33" cy="48" rx="12" ry="15" fill="#1e222b" transform="rotate(-15 33 48)"/>
        <ellipse cx="67" cy="48" rx="12" ry="15" fill="#1e222b" transform="rotate(15 67 48)"/>
        <circle cx="35" cy="46" r="4.5" fill="#ffffff"/>
        <circle cx="33" cy="48" r="2" fill="#00ffcc"/>
        <circle cx="65" cy="46" r="4.5" fill="#ffffff"/>
        <circle cx="67" cy="48" r="2" fill="#00ffcc"/>
        <ellipse cx="22" cy="62" rx="6" ry="4" fill="#ff99b6" opacity="0.7"/>
        <ellipse cx="78" cy="62" rx="6" ry="4" fill="#ff99b6" opacity="0.7"/>
        <polygon points="46,58 54,58 50,63" fill="#1e222b"/>
        <path d="M 45 66 Q 50 71 55 66" stroke="#1e222b" stroke-width="2.5" fill="transparent" stroke-linecap="round"/>
      </svg>
    </div>

    <!-- Live Telemetry Card -->
    <div class="info-display shift-right" id="infoBox">
      <span class="hud-title" id="cardCategory">FETCHING HARDWARE METRICS...</span>
      <span class="hud-stat" id="cardValue">Scanning System...</span>
      <span class="hud-desc" id="cardSub">PanDA is reading kernel data</span>
    </div>

  </div>

  <script>
    let liveSteps = [];
    let currentStep = 0;

    const panda = document.getElementById("pandaActor");
    const infoBox = document.getElementById("infoBox");
    const speech = document.getElementById("speechText");
    const title = document.getElementById("cardCategory");
    const stat = document.getElementById("cardValue");
    const sub = document.getElementById("cardSub");

    function renderSlide() {
      if (currentStep >= liveSteps.length) {
        speech.innerText = "All Clear! PanDA sleeping...";
        setTimeout(() => {
          document.getElementById("hudContainer").style.transform = "translateY(-200px)";
          document.getElementById("hudContainer").style.opacity = "0";
        }, 1500);
        return;
      }

      const step = liveSteps[currentStep];

      // Move Panda across and switch text alignment
      panda.className = "panda-character " + step.position;
      infoBox.className = "info-display " + step.shift;
      
      speech.innerText = step.speech;
      title.innerText = step.category;
      stat.innerText = step.value;
      sub.innerText = step.sub;

      currentStep++;
      setTimeout(renderSlide, 3500); // 3.5 seconds per slide
    }

    // Call Python pywebview API when UI loads
    window.addEventListener('pywebviewready', async () => {
      try {
        liveSteps = await window.pywebview.api.get_hardware_telemetry();
        setTimeout(renderSlide, 600);
      } catch (err) {
        stat.innerText = "Bridge Error";
        sub.innerText = err;
      }
    });
  </script>
</body>
</html>
