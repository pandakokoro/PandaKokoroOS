import psutil
import time

def get_system_hardware_stats():
    # 1. RAM Usage
    ram = psutil.virtual_memory()
    ram_total_gb = round(ram.total / (1024**3), 2)
    ram_used_gb = round(ram.used / (1024**3), 2)
    ram_percent = ram.percent

    # 2. CPU & Storage (Disk)
    cpu_percent = psutil.cpu_percent(interval=1)
    disk = psutil.disk_usage('/')
    disk_free_gb = round(disk.free / (1024**3), 2)
    disk_percent = disk.percent

    # 3. CPU Temperature (Linux/Hardware Sensor Support)
    temp = "N/A"
    try:
        temps = psutil.sensors_temperatures()
        if 'coretemp' in temps:
            temp = f"{temps['coretemp'][0].current}°C"
        elif temps:
            first_sensor = list(temps.values())[0]
            temp = f"{first_sensor[0].current}°C"
    except Exception:
        temp = "Sensor Locked"

    return {
        "ram_used": f"{ram_used_gb}/{ram_total_gb} GB ({ram_percent}%)",
        "disk_free": f"{disk_free_gb} GB Free ({100 - disk_percent}% Available)",
        "cpu_usage": f"{cpu_percent}%",
        "cpu_heat": temp
    }

# टेस्ट आउटपुट
print(get_system_hardware_stats())
