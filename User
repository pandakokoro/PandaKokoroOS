import webview
import psutil
import time

class PandaTelemetryAPI:
    def get_hardware_telemetry(self):
        # 1. Real-time RAM Data
        ram = psutil.virtual_memory()
        ram_total_gb = round(ram.total / (1024**3), 1)
        ram_used_gb = round(ram.used / (1024**3), 1)
        ram_percent = ram.percent

        # 2. CPU Usage & Heat
        cpu_usage = psutil.cpu_percent(interval=None)
        cpu_heat = "42°C"
        try:
            temps = psutil.sensors_temperatures()
            if temps:
                first_sensor = list(temps.values())[0]
                cpu_heat = f"{int(first_sensor[0].current)}°C"
        except Exception:
            cpu_heat = "Optimal"

        # 3. Storage Data (Disk)
        disk = psutil.disk_usage('/')
        disk_free_gb = round(disk.free / (1024**3), 1)
        disk_total_gb = round(disk.total / (1024**3), 1)
        disk_percent = 100 - disk.percent

        # 4. Background Security Health Check
        running_proc_count = len(psutil.pids())
        security_score = max(75, 100 - int(running_proc_count / 15))

        # Payload formatted for Panda UI Sliding Sequence
        return [
            {
                "category": "SYSTEM RAM USAGE",
                "value": f"{ram_used_gb} / {ram_total_gb} GB ({ram_percent}%)",
                "sub": f"Available: {round(ram.available / (1024**3), 1)} GB • Healthy",
                "speech": "RAM status checked! Smooth.",
                "position": "pos-left",
                "shift": "shift-right"
            },
            {
                "category": "CPU LOAD & TEMPERATURE",
                "value": f"{cpu_usage}% Usage • {cpu_heat}",
                "sub": "Thermal levels are cool & safe",
                "speech": "CPU is running chill!",
                "position": "pos-right",
                "shift": "shift-left"
            },
            {
                "category": "DISK STORAGE CAPACITY",
                "value": f"{disk_free_gb} GB Free / {disk_total_gb} GB",
                "sub": f"{disk_percent}% Space currently available",
                "speech": "Storage is clean and clear!",
                "position": "pos-left",
                "shift": "shift-right"
            },
            {
                "category": "PanDA SYSTEM SHIELD",
                "value": f"{security_score}% Protected",
                "sub": f"Monitoring {running_proc_count} active background tasks",
                "speech": "Everything is protected!",
                "position": "pos-right",
                "shift": "shift-left"
            }
        ]

if __name__ == '__main__':
    api = PandaTelemetryAPI()
    
    # Creates a transparent, frameless floating HUD on top of screen
    window = webview.create_window(
        title='PanDA HUD Overlay',
        url='index.html',
        js_api=api,
        frameless=True,
        on_top=True,
        transparent=True,
        width=880,
        height=180
    )
    webview.start()
