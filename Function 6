      topBar.classList.add('dissolved');
      avatarCore.classList.add('dissolved');
      r1.classList.add('broken');
      r2.classList.add('broken');
      telemetryCard.classList.add('dissolved');

      streamDiv.innerHTML = '';
      streamDiv.classList.add('active');
      let logIdx = 0;
      cachePurgeInterval = setInterval(() => {
        if (logIdx < MOCK_CACHE_LOGS.length) {
          const line = document.createElement('div');
          line.className = 'purge-terminal-line';
          line.innerText = MOCK_CACHE_LOGS[logIdx];
          streamDiv.appendChild(line);
          if (streamDiv.children.length > 8) {
            streamDiv.removeChild(streamDiv.firstChild);
          }
          logIdx++;
        }
      }, 750);

      playRocketThrusterSound();

      setTimeout(() => {
        clearInterval(cachePurgeInterval);
        streamDiv.classList.remove('active');
        streamDiv.innerHTML = '';
        triggerLightBurst();
        currentRocketPoints = [];
      }, 6800);

      setTimeout(() => {
        isRocketActive = false;
        isReentryPhase = true;

        avatarCore.classList.remove('dissolved');
        r1.classList.remove('broken');
        r2.classList.remove('broken');
        topBar.classList.remove('dissolved');

        setTimeout(() => {
          isReentryPhase = false;
          telemetryCard.classList.remove('dissolved');
          avatarCore.classList.add('soft-reentry');

          setTimeout(() => {
            avatarCore.classList.remove('soft-reentry');
          }, 5000);

        }, 2500);

      }, 7200);
    }

    function resize() {
      canvas.width = bCanvas.width = pCanvas.width = window.innerWidth;
      canvas.height = bCanvas.height = pCanvas.height = window.innerHeight;
      initParticles();
    }
    window.addEventListener('resize', resize);

    function initParticles() {
      particles = [];
      const count = Math.floor((canvas.width * canvas.height) / 5500);
      for (let i = 0; i < count; i++) {
        const isDark = Math.random() < 0.35;
        particles.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          vx: (Math.random() - 0.5) * 0.7,
          vy: (Math.random() - 0.5) * 0.7,
          radius: isDark ? Math.random() * 3 + 1.8 : Math.random() * 2 + 1,
          isDark: isDark,
          alpha: Math.random() * 0.6 + 0.3,
          ptIdx: i,
          angle: (i / count) * Math.PI * 2,
          orbitDist: Math.random() * 350 + 60
        });
      }
    }

    const BRAND_STR = "Panda OS";
    function renderBrandChars(str) {
      const brandWrap = document.getElementById('titleWrap');
      if (!brandWrap) return;
      brandWrap.innerHTML = '';
      for (let i = 0; i < str.length; i++) {
        const ch = str[i];
        const span = document.createElement('span');
        span.className = 'p-char';
        span.innerHTML = ch === ' ' ? '&nbsp;' : ch;
        span.id = 'pchar_' + i;
        brandWrap.appendChild(span);
      }
    }

    function initBrokenTitle() {
      const TITLE_STR = "THREAT AUDIT & MEMORY PURGE";
      const titleWrap = document.getElementById('brokenTitleWrap');
      if (!titleWrap) return;
      titleWrap.innerHTML = '<img src="panda_logo.png" class="warn-shield" alt="Warning Shield" />';
      for (let i = 0; i < TITLE_STR.length; i++) {
        const ch = TITLE_STR[i];
        const span = document.createElement('span');
        if (ch === ' ') {
          span.className = 'broken-char space';
        } else {
          span.className = 'broken-char';
          span.innerText = ch;
          span.style.setProperty('--r', Math.random().toFixed(2));
        }
        titleWrap.appendChild(span);
      }
    }

    function animateParticles() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const isCritical = currentRamPercent >= 90;
      const speedMult = isCritical ? 2.2 : 1;
      const isDark = (currentActiveTab === 'panda_dark');
      const centerX = canvas.width / 2;
      const centerY = canvas.height / 2;
      const originX = isDark ? 105 : centerX;
      const originY = isDark ? 145 : centerY;

      formMorphProgress += 0.02;

      for (let i = 0; i < particles.length; i++) {
        let p = particles[i];

        if (isRocketActive && currentRocketPoints.length > 0) {
          const pt = currentRocketPoints[p.ptIdx % currentRocketPoints.length];
          p.x += (centerX + pt.x - p.x) * 0.09;
          p.y += (centerY + pt.y - p.y) * 0.09;

          if (i % 8 === 0) {
            ctx.strokeStyle = 'rgba(0, 255, 204, 0.22)';
            ctx.lineWidth = 0.8;
            ctx.beginPath();
            ctx.moveTo(centerX, centerY);
            ctx.lineTo(p.x, p.y);
            ctx.stroke();
          }
        } else if (isReentryPhase) {
          const angle = p.angle + formMorphProgress * 2;
          const targetX = 105 + Math.cos(angle) * (p.orbitDist * 0.6);
          const targetY = 145 + Math.sin(angle) * (p.orbitDist * 0.6);
          p.x += (targetX - p.x) * 0.08;
          p.y += (targetY - p.y) * 0.08;
        } else if (isDark) {
          const form = COSMIC_FORMS[currentFormIndex];
          p.angle += 0.02 * speedMult;
          let r = p.orbitDist;
          if (form.type === 'star') {
            r = p.orbitDist * (0.6 + 0.4 * Math.cos(form.points * p.angle + formMorphProgress));
          } else if (form.type === 'spiral') {
            r = (p.orbitDist * 0.4) + ((p.angle * 25) % 200);
          }
          p.x += (originX + Math.cos(p.angle) * r - p.x) * 0.08;
          p.y += (originY + Math.sin(p.angle) * r - p.y) * 0.08;
        } else {
          p.x += p.vx * speedMult; p.y += p.vy * speedMult;
          if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
          if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
        }

        if (p.isDark) {
          ctx.fillStyle = `rgba(0, 0, 0, ${p.alpha * 0.9})`;
        } else {
          if (isRocketActive || isReentryPhase) {
            ctx.fillStyle = `rgba(0, 255, 204, ${p.alpha * 1.2})`;
          } else if (isCritical) {
            ctx.fillStyle = `rgba(239, 68, 68, ${p.alpha})`;
          } else if (currentRamPercent >= 60) {
            ctx.fillStyle = `rgba(245, 158, 11, ${p.alpha})`;
          } else {
            ctx.fillStyle = isDark ? `rgba(0, 240, 255, ${p.alpha})` : `rgba(0, 255, 204, ${p.alpha})`;
          }
        }

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fill();

        for (let j = i + 1; j < particles.length; j++) {
          let p2 = particles[j];
          let dist = Math.hypot(p.x - p2.x, p.y - p2.y);
          if (dist < (isRocketActive ? 40 : (isReentryPhase ? 50 : (isDark ? 55 : 80)))) {
            ctx.strokeStyle = (isRocketActive || isReentryPhase) ? 'rgba(0, 255, 204, 0.25)' : (isDark ? 'rgba(0, 240, 255, 0.16)' : 'rgba(0, 255, 204, 0.12)');
            ctx.lineWidth = 0.8;
            ctx.beginPath();
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.stroke();
          }
        }
      }
      requestAnimationFrame(animateParticles);
    }

    function handleTabClick(targetTab) {
