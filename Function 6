    position:fixed; top:0; left:0; width:100%; height:100%;
    background:rgba(2,4,10,0.88); backdrop-filter:blur(18px);
    z-index:99; display:none; align-items:center; justify-content:center;
  }
  .modal-box {
    width:560px; background:rgba(15,23,42,0.95); border:2px solid #ef4444;
    border-radius:20px; padding:30px; box-shadow:0 0 45px rgba(239,68,68,0.4);
    display:flex; flex-direction:column; align-items:center; text-align:center;
  }
