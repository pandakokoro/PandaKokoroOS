    function generate1of1RocketSimulation(burnedList) {
      let seed = Math.floor(Math.random() * 9999999);
      let sig = "ROCKET_CACHE_" + (seed % 1000) + "_" + Math.floor(Math.random() * 88888);

      while (burnedList && burnedList.includes(sig)) {
        seed = Math.floor(Math.random() * 9999999);
        sig = "ROCKET_CACHE_" + (seed % 1000) + "_" + Math.floor(Math.random() * 88888);
      }

      const pts = [];
      const mode = seed % 3;

      if (mode === 0) {
        for (let y = -90; y <= 60; y += 6) {
          const w = Math.sin((y + 90) / 150 * Math.PI) * 22 + 4;
          for (let x = -w; x <= w; x += 8) pts.push({ x: x, y: y });
        }
        for (let i = 0; i <= 10; i++) {
          pts.push({ x: 0, y: -90 - i * 4 });
          pts.push({ x: -i * 1.5, y: -90 - i * 3 });
          pts.push({ x: i * 1.5, y: -90 - i * 3 });
        }
        for (let y = 65; y <= 130; y += 7) {
          const spread = (y - 65) * 0.45;
          for (let x = -spread; x <= spread; x += 10) pts.push({ x: x, y: y });
        }
      } else if (mode === 1) {
        for (let y = -70; y <= 50; y += 6) {
          pts.push({ x: 0, y: y }); pts.push({ x: -18, y: y }); pts.push({ x: 18, y: y });
        }
        for (let i = -30; i <= 30; i += 6) pts.push({ x: i, y: 55 });
        for (let y = 60; y <= 120; y += 8) {
          for (let x = -12; x <= 12; x += 6) pts.push({ x: x, y: y });
        }
      } else {
        for (let a = 0; a < Math.PI * 2; a += 0.25) {
          pts.push({ x: Math.cos(a) * 35, y: Math.sin(a) * 35 });
          pts.push({ x: Math.cos(a) * 65, y: Math.sin(a) * 65 });
        }
        for (let y = -40; y <= 110; y += 8) pts.push({ x: 0, y: y });
      }

      return { signature: sig, points: pts };
    }

    let audioCtx = null;
    function playRocketThrusterSound() {
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();

        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sawtooth';

        const now = audioCtx.currentTime;
        osc.frequency.setValueAtTime(45, now);
        osc.frequency.exponentialRampToValueAtTime(220, now + 4.5);
        osc.frequency.exponentialRampToValueAtTime(900, now + 6.6);
        osc.frequency.exponentialRampToValueAtTime(70, now + 7.2);

        gain.gain.setValueAtTime(0.01, now);
        gain.gain.linearRampToValueAtTime(0.15, now + 4.5);
        gain.gain.linearRampToValueAtTime(0.28, now + 6.5);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 7.2);

        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(now + 7.3);
      } catch (e) {}
    }

    function playBoomAttackSound() {
      try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        if (audioCtx.state === 'suspended') audioCtx.resume();

        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = 'sine';

        const now = audioCtx.currentTime;
        osc.frequency.setValueAtTime(180, now);
        osc.frequency.exponentialRampToValueAtTime(30, now + 0.4);

        gain.gain.setValueAtTime(0.35, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.45);

        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(now + 0.5);
      } catch(e) {}
    }

    function triggerLightBurst() {
      const cx = window.innerWidth / 2;
      const cy = window.innerHeight / 2;
      burstRays = [];
      for (let i = 0; i < 160; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = Math.random() * 12 + 6;
        burstRays.push({
          x: cx, y: cy,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          alpha: 1,
          color: Math.random() > 0.5 ? '#00ffcc' : '#ffffff'
        });
      }
    }

    function renderLightBurst() {
      bCtx.clearRect(0, 0, bCanvas.width, bCanvas.height);
      for (let i = burstRays.length - 1; i >= 0; i--) {
        let r = burstRays[i];
        r.x += r.vx; r.y += r.vy;
        r.vx *= 0.95; r.vy *= 0.95;
        r.alpha -= 0.035;

        if (r.alpha <= 0) { burstRays.splice(i, 1); continue; }

        bCtx.strokeStyle = r.color;
        bCtx.shadowColor = r.color;
        bCtx.shadowBlur = 15;
        bCtx.lineWidth = 2.5;
        bCtx.beginPath();
        bCtx.moveTo(r.x, r.y);
        bCtx.lineTo(r.x - r.vx * 2, r.y - r.vy * 2);
        bCtx.stroke();
        bCtx.shadowBlur = 0;
      }
      requestAnimationFrame(renderLightBurst);
    }
    renderLightBurst();

    async function triggerRocketSimulationDrop() {
      if (isRocketActive || isRightCenterShield) return;

      let burned = [];
      try {
        if (window.pywebview && window.pywebview.api) {
          burned = await window.pywebview.api.get_burned_holograms();
        }
      } catch (e) {}

      const drop = generate1of1RocketSimulation(burned);
      try {
        if (window.pywebview && window.pywebview.api) {
          await window.pywebview.api.burn_hologram_signature(drop.signature);
        }
      } catch (e) {}

      isRocketActive = true;
      isReentryPhase = false;
      currentRocketPoints = drop.points;

      const topBar = document.getElementById('topBar');
      const avatarCore = document.getElementById('avatarCoreRef');
      const telemetryCard = document.getElementById('telemetryCard');
      const r1 = document.getElementById('radar1');
      const r2 = document.getElementById('radar2');
