    background:rgba(2,4,10,0.94); backdrop-filter:blur(24px);
  }
  #viewAegis.active { display:flex !important; }
  .aegis-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; border-bottom:1px solid rgba(0,240,255,0.2); padding-bottom:14px; }
  .aegis-deck-title { font-size:20px; font-weight:900; color:#00f0ff; letter-spacing:2px; text-shadow:0 0 15px rgba(0,240,255,0.6); }
