<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Panda OS - RAM Dominance Engine</title>
<style>
  * { margin:0; padding:0; box-sizing:border-box; font-family:'Consolas','Segoe UI',monospace; user-select:none; }
  body { background:#02040a; color:#f8fafc; height:100vh; width:100vw; overflow:hidden; position:relative; display:flex; flex-direction:column; }

  #particleCanvas { position:absolute; top:0; left:0; width:100%; height:100%; z-index:1; pointer-events:none; }
  #shatterCanvas { position:absolute; top:0; left:0; width:100%; height:100%; z-index:12; pointer-events:none; }
  #pulseCanvas { position:absolute; top:0; left:0; width:100%; height:100%; z-index:40; pointer-events:none; }
  #lightBurstCanvas { position:absolute; top:0; left:0; width:100%; height:100%; z-index:50; pointer-events:none; }

  /* CYBER TERMINAL CACHE PURGE STREAM (LEFT SIDE) */
  #cachePurgeStream {
    position: absolute; left: 40px; top: 120px; width: 420px; height: 360px;
    z-index: 60; pointer-events: none; display: none; flex-direction: column; gap: 6px;
    font-family: 'Consolas', monospace; font-size: 11px; font-weight: 800;
  }
  #cachePurgeStream.active { display: flex !important; }
  .purge-terminal-line {
    color: #00ffcc; text-shadow: 0 0 8px rgba(0,255,204,0.6);
    background: rgba(2, 6, 23, 0.75); border-left: 3px solid #00ffcc;
    padding: 6px 10px; border-radius: 4px; backdrop-filter: blur(8px);
    opacity: 0; transform: translateX(-20px);
    animation: terminalLineSlide 0.3s forwards ease-out;
  }
  @keyframes terminalLineSlide {
    to { opacity: 1; transform: translateX(0); }
  }

  /* DYNAMIC INACTIVE FILE AUDIT FEED */
  #easterEggStream {
    position: absolute; left: 50px; top: 140px; width: 460px; height: 260px;
    z-index: 120; pointer-events: none; display: none; flex-direction: column; gap: 8px;
  }
  #easterEggStream.active { display: flex !important; }
  .easter-egg-line {
    color: #00ffcc; text-shadow: 0 0 12px rgba(0,255,204,0.9);
    background: rgba(2, 6, 23, 0.9); border-left: 3px solid #00f0ff;
    padding: 10px 14px; border-radius: 8px; backdrop-filter: blur(10px);
    font-size: 11px; line-height: 1.4;
    opacity: 0; transform: translateX(-25px);
    animation: terminalLineSlide 0.35s forwards ease-out;
  }

  /* [ ESC ] EXIT HINT BUTTON */
  #escExitBtn {
    position: fixed; top: 20px; right: 25px; z-index: 150;
    background: rgba(0, 240, 255, 0.2); border: 1.5px solid #00f0ff; color: #00f0ff;
    padding: 6px 14px; border-radius: 8px; font-weight: 900; font-size: 12px;
    cursor: pointer; display: none; box-shadow: 0 0 18px rgba(0,240,255,0.4);
    transition: 0.3s;
  }
  #escExitBtn:hover { background: #00f0ff; color: #020417; box-shadow: 0 0 28px #00f0ff; }
  #escExitBtn.active { display: block !important; }

  .top-bar {
    z-index:30; display:flex; justify-content:space-between; align-items:center;
    padding:12px 30px; position:relative; height:65px; min-height:65px;
    background: linear-gradient(90deg, #02040a 0%, #030712 50%, rgba(245, 158, 11, 0.15) 100%);
    border-bottom: 3px double #00ffcc;
    box-shadow: 0 4px 18px rgba(0, 255, 204, 0.4);
    transition: opacity 0.6s ease, transform 0.6s ease, background 0.6s ease;
  }
  .top-bar.dissolved { opacity: 0 !important; pointer-events: none; transform: translateY(-20px); }

  .brand-group {
    display:flex; align-items:center; gap:14px; cursor:pointer; padding:4px 8px; border-radius:10px; transition:0.3s;
    position:relative;
  }
  .brand-group:hover { background:rgba(0,255,204,0.08); }

  .brand-logo {
    width:42px; height:42px; border-radius:6px; object-fit:contain;
    filter:drop-shadow(0 0 8px #000);
    transition: all 0.9s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .brand-logo.aligned-dark-orbit {
    position: fixed !important; left: 105px !important; top: 145px !important;
    transform: scale(1.65); z-index: 100;
    filter: drop-shadow(0 0 25px #00f0ff) drop-shadow(0 0 45px rgba(0,240,255,0.8));
    animation: auraPulse 2.5s infinite ease-in-out alternate;
  }

  .title-chars-wrap { display:flex; }
  .p-char {
    display:inline-block; font-size:20px; font-weight:900; letter-spacing:2px;
    color:#00ffcc; text-shadow:0 0 10px #00ffcc;
    transition: opacity 0.25s ease, transform 0.25s ease, filter 0.25s ease;
  }
  .p-char.erased { opacity: 0 !important; transform: translateY(-4px) scale(0.7); filter: blur(4px); }

  .cosmic-form-badge {
    position:absolute; left:calc(50% + 95px); top:50%; transform:translateY(-50%);
    font-size:10px; font-weight:900; letter-spacing:1.5px; color:#00f0ff;
    padding:4px 10px; border-radius:12px; border:1px solid #00f0ff;
    background:rgba(0,240,255,0.12); box-shadow:0 0 10px rgba(0,240,255,0.3);
    opacity:0; pointer-events:none; transition: opacity 0.5s ease; z-index:36;
  }
  .cosmic-form-badge.active { opacity:1 !important; }
  
  .aegis-center-badge {
    position:absolute; left:50%; top:50%; transform:translate(-50%, -50%);
    display:flex; align-items:center; justify-content:center;
    cursor:pointer; z-index:35; padding:6px 16px; border-radius:20px;
    border:1.5px solid rgba(0,240,255,0.4); background:rgba(2,6,23,0.7);
    box-shadow:0 0 15px rgba(0,240,255,0.2);
    transition: width 0.6s cubic-bezier(0.25, 1, 0.5, 1), height 0.6s ease, border-radius 0.6s ease, padding 0.6s ease, transform 0.3s ease, border-color 0.5s ease;
    animation: aegisFloat 3s infinite ease-in-out alternate;
  }
  .aegis-center-badge.collapsed-orb {
    width: 32px !important; height: 32px !important;
    border-radius: 50% !important; padding: 0 !important;
    background: linear-gradient(135deg, #00f0ff 50%, var(--dynamic-color, #f59e0b) 50%) !important;
    border: 1.5px solid #00f0ff !important;
    box-shadow: 0 0 25px #00f0ff, 0 0 35px var(--dynamic-color, #f59e0b) !important;
    animation: orbGlow 1.5s infinite alternate ease-in-out;
  }
  .aegis-center-badge.collapsed-orb .aegis-core-text,
  .aegis-center-badge.collapsed-orb .aegis-dots-wrap {
    opacity: 0 !important; pointer-events: none;
  }

  .aegis-core-text {
    font-size:16px; font-weight:900; letter-spacing:5px;
    background: linear-gradient(90deg, #00f0ff 0%, #00f0ff 45%, var(--dynamic-color, #f59e0b) 55%, var(--dynamic-color, #f59e0b) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 10px rgba(0,240,255,0.6)) drop-shadow(0 0 16px var(--dynamic-color, #f59e0b));
    text-transform: uppercase;
  }
  .aegis-dots-wrap {
    position:absolute; width:125%; height:125%; display:flex; justify-content:space-between; align-items:center; pointer-events:none;
  }
  .aegis-micro-dot {
    width:5px; height:5px; border-radius:50%; background:#00f0ff; box-shadow:0 0 10px #00f0ff;
    animation: dotOrbit 2s infinite ease-in-out alternate;
  }
  .aegis-micro-dot.right {
    background:var(--dynamic-color, #f59e0b); box-shadow:0 0 10px var(--dynamic-color, #f59e0b); animation-delay: 1s;
  }

  .status-wrap { position:relative; display:flex; justify-content:flex-end; align-items:center; width:340px; height:42px; }
  .status-tag {
    width:310px; height:38px; border-radius:20px;
    border:1.5px solid #f59e0b; background:rgba(245, 158, 11, 0.2); color:#f59e0b;
    cursor:pointer; display:flex; align-items:center; justify-content:center;
    box-shadow:0 0 14px rgba(245, 158, 11, 0.4); overflow:hidden; white-space:nowrap;
    transform-origin: right center;
    transition: width 0.6s cubic-bezier(0.25, 1, 0.5, 1), border-radius 0.6s ease, box-shadow 1s ease;
  }
  .status-tag-text {
    font-size:12px; font-weight:800; opacity:1; transition: opacity 0.4s ease; display:flex; align-items:center; gap:8px;
  }
  .status-tag.collapsed {
    width:38px !important; border-radius:50% !important; padding:0 !important;
    box-shadow:0 0 25px currentColor, inset 0 0 10px currentColor !important;
    animation: orbGlow 1.5s infinite alternate ease-in-out;
  }
  .status-tag.collapsed .status-tag-text { opacity:0 !important; pointer-events:none; }

  #viewMain {
    z-index:10; flex:1; display:flex; align-items:center; justify-content:center;
    gap:45px; padding:20px 40px; position:relative;
    transition:0.6s all cubic-bezier(0.4, 0, 0.2, 1);
  }
  #viewMain.hide-away { opacity:0; pointer-events:none; }

  .avatar-core {
    position:relative; width:270px; height:270px; display:flex; align-items:center; justify-content:center;
    cursor:pointer; transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), transform 0.6s ease;
  }
  .avatar-core.dissolved, .avatar-core.mini-hidden { opacity: 0 !important; pointer-events: none; transform: scale(0.6); }
  .avatar-core.soft-reentry { opacity: 0.15 !important; transition: opacity 0.6s ease; }
  .avatar-core:hover .avatar-box { box-shadow:0 0 45px rgba(0,255,204,0.8); transform:scale(1.04); }
  
  .radar-ring { position:absolute; border-radius:50%; border:2px dashed #00ffcc; width:260px; height:260px; animation:rotateRing 14s linear infinite; opacity:0.6; pointer-events:none; }
  .radar-ring-2 { position:absolute; border-radius:50%; border:1px solid rgba(0,255,204,0.3); width:285px; height:285px; animation:rotateRingRev 18s linear infinite; pointer-events:none; }
  .radar-ring.broken, .radar-ring-2.broken { opacity:0 !important; transform:scale(1.3); filter:blur(10px); }

  .avatar-box {
    position:relative; width:215px; height:215px; border-radius:50%; overflow:hidden;
    border:2.5px solid #00ffcc; box-shadow:0 0 30px rgba(0,255,204,0.4); z-index:2; background:#02040a;
    transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1), transform 0.8s ease, filter 0.8s ease;
  }
  .avatar-box::after {
    content:''; position:absolute; top:0; left:0; width:100%; height:100%; border-radius:50%; box-shadow:inset 0 0 30px 15px #02040a; pointer-events:none;
  }
  .avatar-box img { width:100%; height:100%; object-fit:cover; display:block; }
  .avatar-box.soft-fade { opacity: 0 !important; transform: scale(0.85); filter: blur(12px); }

  /* TELEMETRY CARD - REGULAR, SHIELD & BOTTOM-RIGHT DOCK */
  .telemetry-card {
    width:430px; background:rgba(2, 6, 23, 0.85); border:1.5px solid rgba(0,255,204,0.4);
    border-radius:18px; padding:24px; backdrop-filter:blur(18px);
    box-shadow:0 0 30px rgba(0,0,0,0.8); cursor: pointer;
    transition: all 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .telemetry-card.dissolved {
    opacity: 0 !important; pointer-events: none; transform: scale(0.8) translateY(20px); filter: blur(10px);
  }

  .telemetry-card.bottom-right-dock {
    position: fixed !important; bottom: 25px !important; right: 25px !important;
    width: 280px !important; padding: 16px !important; border-radius: 14px !important;
    border-color: #00ffcc !important; box-shadow: 0 0 35px rgba(0,255,204,0.5) !important;
    z-index: 100 !important; opacity: 1 !important; transform: scale(1) translateY(0) !important;
  }

  .telemetry-card.right-center-shield {
    position: fixed !important;
    top: 50% !important; right: 60px !important;
    transform: translateY(-50%) !important;
    width: 320px !important; height: 320px !important;
    border-radius: 50% !important;
    border: 3px solid #00f0ff !important;
    background: radial-gradient(circle, rgba(2,6,23,0.95) 0%, rgba(0,240,255,0.2) 100%), url('aegis_shield.png') !important;
    background-size: cover !important; background-position: center !important;
    box-shadow: 0 0 60px rgba(0,240,255,0.85), inset 0 0 30px rgba(0,240,255,0.4) !important;
    display: flex !important; flex-direction: column !important;
    align-items: center !important; justify-content: center !important;
    text-align: center !important; z-index: 100 !important;
    animation: shieldPulse 2s infinite alternate ease-in-out;
  }
  .telemetry-card.right-center-shield .gauge-title { font-size: 16px !important; letter-spacing: 4px !important; color: #fff !important; text-shadow: 0 0 12px #00f0ff; margin-bottom: 0 !important; background: rgba(0,0,0,0.75); padding: 8px 18px; border-radius: 8px; }
  .telemetry-card.right-center-shield .gauge-value,
  .telemetry-card.right-center-shield .progress-bg,
  .telemetry-card.right-center-shield .metric-grid { display: none !important; }

  @keyframes shieldPulse {
    0% { box-shadow: 0 0 30px rgba(0,240,255,0.5); transform: translateY(-50%) scale(1); }
    100% { box-shadow: 0 0 75px rgba(0,240,255,0.95); transform: translateY(-50%) scale(1.04); }
  }

  .gauge-title { font-size:12px; font-weight:900; color:#94a3b8; letter-spacing:1.5px; margin-bottom:6px; }
  .gauge-value { font-size:36px; font-weight:900; color:#fff; text-shadow:0 0 15px #00ffcc; margin-bottom:12px; }
  .progress-bg { width:100%; height:10px; background:rgba(255,255,255,0.06); border-radius:5px; overflow:hidden; margin-bottom:18px; border:1px solid rgba(255,255,255,0.1); }
  .progress-bar { height:100%; width:0%; background:#00ffcc; box-shadow:0 0 12px #00ffcc; transition:width 0.6s ease; }

  .metric-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .metric-pill { background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.06); padding:10px 14px; border-radius:10px; }
  .pill-lbl { font-size:11px; color:#64748b; font-weight:700; }
  .pill-val { font-size:15px; color:#fff; font-weight:900; margin-top:3px; }

  #viewPurge {
    position:absolute; top:75px; left:0; width:100%; height:calc(100vh - 75px);
    z-index:25; display:none; flex-direction:column; padding:25px 40px;
    background:rgba(2,4,10,0.92); backdrop-filter:blur(22px);
  }
  #viewPurge.active { display:flex !important; }
  .purge-header { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; border-bottom:1px solid rgba(239,68,68,0.2); padding-bottom:14px; }
  .broken-title-wrap { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
  .warn-shield { width:28px; height:28px; object-fit:contain; filter:drop-shadow(0 0 10px #ef4444); }
  .broken-char {
    display:inline-block; font-size:22px; font-weight:900; color:#ef4444;
    text-shadow: 0 0 12px rgba(239, 68, 68, 0.7); margin-right: 12px;
    transform: rotate(calc(-4deg + 8deg * var(--r)));
    clip-path: polygon(0 0, 100% 0, 85% 100%, 0% 100%);
  }
  .broken-char.space { width: 25px; margin-right: 0; }
  .purge-list { flex:1; overflow-y:auto; display:flex; flex-direction:column; gap:14px; padding-right:10px; }
  .app-row {
    display:flex; justify-content:space-between; align-items:center;
    background:rgba(15,23,42,0.6); border:1px solid rgba(255,255,255,0.08);
    padding:14px 20px; border-radius:12px; transition:0.3s;
  }
  .app-row.hit-shake {
    animation: targetHit 0.4s ease-in-out; border-color: #ef4444 !important; box-shadow: 0 0 25px rgba(239, 68, 68, 0.6) !important;
  }
  .app-row:hover { border-color:#00ffcc; background:rgba(30,41,59,0.8); }
  .app-info { display:flex; flex-direction:column; gap:4px; }
  .app-title-tag { display:flex; align-items:center; gap:8px; }
  .app-name { font-size:15px; font-weight:900; color:#fff; }
  .app-tag { font-size:10px; padding:2px 8px; border-radius:10px; background:rgba(0,255,204,0.1); border:1px solid #00ffcc; color:#00ffcc; font-weight:800; }
  .app-meta { font-size:12px; color:#94a3b8; }
  .btn-group { display:flex; gap:10px; }
  .temp-btn { background:rgba(245,158,11,0.2); border:1px solid #f59e0b; color:#f59e0b; padding:8px 14px; border-radius:6px; font-weight:900; font-size:11px; cursor:pointer; }
  .temp-btn:hover { background:#f59e0b; color:#020617; box-shadow:0 0 12px #f59e0b; }
  .perm-btn { background:rgba(239,68,68,0.2); border:1px solid #ef4444; color:#ef4444; padding:8px 14px; border-radius:6px; font-weight:900; font-size:11px; cursor:pointer; }
