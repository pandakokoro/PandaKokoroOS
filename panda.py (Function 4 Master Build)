    // --- NEON BEAM ENGINE (10s - 60s Idle Mode) ---
    const canvas = document.getElementById('laserCanvas');
    const ctx = canvas.getContext('2d');
    function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    function clearCanvas() { ctx.clearRect(0, 0, canvas.width, canvas.height); }

    function scheduleNextBeam() {
      if (isPulseActive) return;
      const randomDelay = Math.floor(Math.random() * 50000) + 10000;
      beamTimeout = setTimeout(() => {
        triggerNeonBeam();
        scheduleNextBeam();
      }, randomDelay);
    }

    function triggerNeonBeam() {
      if (isPulseActive) return;
      const w = canvas.width, h = canvas.height;
      const patterns = [
        { x1:0, y1:0, x2:w, y2:h, c:'#00ffcc' },
        { x1:w, y1:0, x2:0, y2:h, c:'#38bdf8' },
        { x1:0, y1:h/2, x2:w, y2:h/2, c:'#a855f7' },
        { x1:w/2, y1:h, x2:w/2, y2:0, c:'#00ffcc' },
        { x1:0, y1:h, x2:w, y2:0, c:'#f43f5e' }
      ];
      const p = patterns[Math.floor(Math.random() * patterns.length)];

      let progress = 0;
      function draw() {
        clearCanvas();
        ctx.strokeStyle = p.c;
        ctx.lineWidth = 3;
        ctx.shadowBlur = 20;
        ctx.shadowColor = p.c;
        ctx.beginPath();
        ctx.moveTo(p.x1, p.y1);
        ctx.lineTo(p.x1 + (p.x2 - p.x1) * progress, p.y1 + (p.y2 - p.y1) * progress);
        ctx.stroke();

        progress += 0.08;
        if (progress <= 1) {
          requestAnimationFrame(draw);
        } else {
          setTimeout(clearCanvas, 200);
        }
      }
      draw();
    }

