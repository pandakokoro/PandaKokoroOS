    async function updateHud() {
      if (!window.pywebview) return;
      const d = await window.pywebview.api.get_system_metrics();
      document.getElementById('hudVal').innerText = 'RAM: ' + d.ram_used_gb + '/' + d.ram_total_gb + ' GB (' + d.ram_percent + '%)';
