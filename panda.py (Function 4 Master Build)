      document.querySelectorAll('#appBar .btn').forEach(b => {
        b.className = b.innerText.toLowerCase().includes(k.toLowerCase()) ? 'btn active' : 'btn';
      });
      const speech = document.getElementById('auditSpeech');
      const dCol = document.getElementById('dangerCol');
      const sCol = document.getElementById('safeCol');
      dCol.classList.remove('visible');
      sCol.classList.remove('visible');
      dCol.innerHTML = '';
      sCol.innerHTML = '';
      speech.innerText = 'PROBING ' + name.toUpperCase() + '...';

      setTimeout(async () => {
        speech.innerText = 'AUDIT COMPLETE: ' + name.toUpperCase();
        const intel = await window.pywebview.api.get_app_intel(k);
        dCol.innerHTML = '<div style="color:#ef4444; font-weight:900; margin-bottom:6px;">IDENTIFIED THREATS</div>';
        sCol.innerHTML = '<div style="color:#00ffcc; font-weight:900; margin-bottom:6px;">DEFENSE METRICS</div>';
        intel.threats.forEach(t => {
          dCol.innerHTML += '<div class="stream" style="border-left:4px solid ' + t.color + '; color:#fff;">' + t.text + '</div>';
        });
        intel.benefits.forEach(b => {
          sCol.innerHTML += '<div class="stream" style="border-right:4px solid ' + b.color + '; color:#fff;">' + b.text + '</div>';
        });
        dCol.classList.add('visible');
        sCol.classList.add('visible');
      }, 700);
    }

    async function loadIntel(k) {
      if (!window.pywebview) return;
      currentData = await window.pywebview.api.get_app_intel(k);
      const m = await window.pywebview.api.get_system_metrics();
      document.getElementById('capStats').innerText = 'Safe Limit:\\n' + m.max_heavy_apps + ' Apps Simultaneously';
      showIntel(0);
