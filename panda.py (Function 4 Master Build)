    function showIntel(idx) {
      if (!currentData) return;
      for (let i = 0; i < 5; i++) {
        const b = document.getElementById('itab-' + i);
        if (b) b.className = (i === idx) ? 'btn active' : 'btn';
      }
      const title = document.getElementById('intelTitle');
      const body = document.getElementById('intelBody');
      const killBtn = document.getElementById('killBtn');
      const box = document.getElementById('intelBox');
      killBtn.style.display = 'none';

      const tabs = [
        { t: 'ORIGIN & PURPOSE', b: '<strong>Maker:</strong> ' + currentData.maker + '<br><br><strong>Purpose:</strong> ' + currentData.purpose, c: '#00ffcc' },
        { t: 'NEUTRAL ALTERNATIVES', b: currentData.neutral, c: '#38bdf8' },
        { t: 'TOXIC / MODDED REPACKS', b: currentData.toxic, c: '#ef4444' },
        { t: 'FORTIFIED BEST ALTERNATIVES', b: currentData.best, c: '#10b981' },
        { t: 'PROCESS TERMINATION', b: 'Active threads detected for <strong>' + currentApp.toUpperCase() + '</strong>. Terminate to free RAM.', c: '#f59e0b', a: true }
      ];

      const cur = tabs[idx];
      title.innerText = cur.t;
      title.style.color = cur.c;
      body.innerHTML = cur.b;
      box.style.borderColor = cur.c;
      if (cur.a) killBtn.style.display = 'block';
    }

    async function killApp() {
      if (!window.pywebview) return;
      const res = await window.pywebview.api.terminate_process_by_name(currentApp);
      alert('Terminated ' + res.killed_count + ' instance(s) of ' + currentApp);
      currentApp = '';
      refreshApps();
      switchView(2);
    }

    window.addEventListener('pywebviewready', () => {
      updateHud();
      refreshApps();
      scheduleNextBeam();
    });
